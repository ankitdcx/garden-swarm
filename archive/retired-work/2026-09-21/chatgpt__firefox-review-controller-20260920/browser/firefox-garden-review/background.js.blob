const SITES={deepseek:"https://chat.deepseek.com/",gemini:"https://gemini.google.com/app",claude:"https://claude.ai/new",grok:"https://grok.com/"};browser.browserAction.onClicked.addListener(async()=>{for(const [id,url] of Object.entries(SITES)){const origin=new URL(url).origin;const tabs=await browser.tabs.query({url:origin+"/*"});if(!tabs.length)await browser.tabs.create({url,active:false});}});