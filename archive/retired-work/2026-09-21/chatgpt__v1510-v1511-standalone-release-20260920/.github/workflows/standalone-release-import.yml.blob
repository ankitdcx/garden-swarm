name: Garden standalone release payload import

on:
  push:
    branches:
      - 'chatgpt/v1510-v1511-standalone-release-20260920'
    paths:
      - 'agent/releases/inbox/Garden_v15.10_STANDALONE_NO_LOSS_CANDIDATE_2026-09-20.zip'

permissions:
  contents: write

concurrency:
  group: garden-standalone-release-import
  cancel-in-progress: false

jobs:
  import:
    if: github.repository == 'ankitdcx/garden-swarm' && github.event.head_commit.message != 'Materialize verified standalone Garden release payload'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.ref_name }}
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Verify and materialize exact release payload
        run: python -m tools.import_standalone_release_payload
      - name: Commit verified UTF-8 content and remove inbox transport
        run: |
          set -euo pipefail
          rm -f agent/releases/inbox/Garden_v15.10_STANDALONE_NO_LOSS_CANDIDATE_2026-09-20.zip
          git config user.name "garden-release-bot"
          git config user.email "garden-release-bot@users.noreply.github.com"
          git add agent/releases/content/GARDEN_CATALOGUE_v15.10.txt
          git add agent/releases/content/SEMANTIC_RETENTION_DISPOSITION_v15.10.jsonl
          git add -u agent/releases/inbox || true
          if git diff --cached --quiet; then
            echo "No release payload changes to commit"
            exit 0
          fi
          git commit -m "Materialize verified standalone Garden release payload"
          git push origin HEAD:${{ github.ref_name }}
