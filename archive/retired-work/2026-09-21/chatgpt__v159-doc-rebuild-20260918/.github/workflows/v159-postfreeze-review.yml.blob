name: Garden v15.9 post-freeze blind review

on:
  push:
    branches:
      - 'chatgpt/v159-postfreeze-scattered-upgrades-20260918'
    paths:
      - 'review-inputs/v159-postfreeze/trigger.json'

permissions:
  contents: read

concurrency:
  group: v159-postfreeze-blind-review
  cancel-in-progress: false

jobs:
  review:
    if: github.repository == 'ankitdcx/garden-swarm'
    strategy:
      fail-fast: false
      max-parallel: 1
      matrix:
        packet:
          - P038_ORH_CIAH
          - P039_UAAC_DSDIH
          - P040_SOURCE_RIGHTS_DELTA_MANAGEMENT
          - P041_MACHINE_INSPECTION_PRIVACY_JUSTICE
        family:
          - deepseek
          - qwen
          - glm
          - xiaomi
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: One blind governed-model review call
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: python tools/v159_postfreeze_single.py --packet "${{ matrix.packet }}" --family "${{ matrix.family }}"
      - name: Upload isolated reviewer evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: v159-postfreeze-${{ matrix.packet }}-${{ matrix.family }}-${{ github.run_id }}
          path: review-results/v159-postfreeze/${{ matrix.packet }}/${{ matrix.family }}.json
          if-no-files-found: error
          retention-days: 30
