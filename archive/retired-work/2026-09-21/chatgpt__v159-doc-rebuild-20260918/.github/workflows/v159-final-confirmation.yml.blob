name: Garden v15.9 R3 final confirmation
on:
  push:
    branches:
      - 'chatgpt/v159-postfreeze-scattered-upgrades-20260918'
    paths:
      - 'review-inputs/v159-postfreeze/final-confirmation-trigger.json'
permissions:
  contents: read
concurrency:
  group: v159-r3-final-confirmation
  cancel-in-progress: false
jobs:
  confirm:
    if: github.repository == 'ankitdcx/garden-swarm'
    strategy:
      fail-fast: false
      max-parallel: 1
      matrix:
        family: [deepseek, glm, gemini]
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Run one isolated R3 final confirmation
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: python tools/v159_final_confirmation.py --family "${{ matrix.family }}"
      - name: Upload confirmation evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: v159-r3-confirmation-${{ matrix.family }}-${{ github.run_id }}
          path: review-results/v159-postfreeze-final-confirmation/${{ matrix.family }}.json
          if-no-files-found: error
          retention-days: 30
