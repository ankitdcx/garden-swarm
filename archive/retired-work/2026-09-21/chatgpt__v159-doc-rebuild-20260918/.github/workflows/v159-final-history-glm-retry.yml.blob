name: Garden v15.9 final history GLM recovery
on:
  push:
    branches:
      - 'chatgpt/v159-postfreeze-scattered-upgrades-20260918'
    paths:
      - 'review-inputs/v159-postfreeze/final-board-glm-retry-trigger.json'
permissions:
  contents: read
concurrency:
  group: v159-final-history-board
  cancel-in-progress: false
jobs:
  retry:
    if: github.repository == 'ankitdcx/garden-swarm'
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Retry GLM final-history slot only
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: python tools/v159_final_history_board.py --family glm
      - name: Upload recovered review evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: v159-final-history-retry-glm2-${{ github.run_id }}
          path: review-results/v159-postfreeze-final-blind/glm.json
          if-no-files-found: error
          retention-days: 30
