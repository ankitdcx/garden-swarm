name: Garden v15.9 documentation structural review
on:
  push:
    branches: ['chatgpt/v159-doc-rebuild-20260918']
    paths: ['review-inputs/v159-doc-rebuild/trigger.json']
permissions:
  contents: read
concurrency:
  group: v159-doc-structural-review
  cancel-in-progress: false
jobs:
  review:
    strategy:
      fail-fast: false
      max-parallel: 1
      matrix:
        family: [deepseek, glm, xiaomi, gemini]
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Review documentation structure
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
        run: python tools/v159_doc_structural_review.py --family "${{ matrix.family }}"
      - name: Upload evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: v159-doc-structural-${{ matrix.family }}-${{ github.run_id }}
          path: review-results/v159-doc-rebuild/structural/${{ matrix.family }}.json
          if-no-files-found: error
          retention-days: 30
