{
  "schema": "GardenEventDrivenContextPolicy/v2",
  "design_epoch": "v15.5",
  "candidate_design_ref": "https://github.com/ankitdcx/garden-main/blob/main/design_deltas/v15.7/EVENT-DRIVEN-CONTEXT-ROUTING-CANDIDATE.md",
  "candidate_correction_ref": "https://github.com/ankitdcx/garden-main/blob/main/design_deltas/v15.7/EVENT-DRIVEN-CONTEXT-ROUTING-CORRECTION-2026-09-16.md",
  "status": "PUBLIC_ADAPTER_CANDIDATE_NO_CANONICAL_EFFECT",
  "public_only": true,
  "request_efficiency_policy": "agents/interactive-request-efficiency-policy.json",
  "request_efficiency_binding": {
    "event_driven_over_polling": true,
    "same_hash_reuse_over_reread": true,
    "rate_limit_circuit_breaker_required": true,
    "efficiency_cannot_reduce_context_or_assurance": true
  },
  "normalization": {
    "preferred_cost_class": "DETERMINISTIC_FREE_OR_LOW_COST",
    "required_observation_schema": "GardenNormalizedContextObservation/v1",
    "required_fields": ["observation_id", "observed_at_unix", "subject", "event_kind", "fingerprint", "changed_fields", "risk", "uncertainty", "source_refs", "evidence_refs", "summary", "public_only"],
    "deduplicate_by": ["subject", "fingerprint"],
    "risk_is_routing_hint_not_truth": true
  },
  "materiality": {
    "risk_at_or_above": "HIGH",
    "risk_order": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
    "trigger_event_kinds": ["SEMANTIC_DELTA", "AUTHORITY_CHANGE", "RIGHTS_CHANGE", "SECURITY_FINDING", "PRIVACY_FINDING", "TEST_FAILURE", "INVARIANT_FAILURE", "PROOF_OBLIGATION_CHANGE", "DEPENDENCY_INVALIDATION", "NEW_OVERTURNING_EVIDENCE"],
    "trigger_uncertainty": ["HIGH", "UNKNOWN", "INCONCLUSIVE"],
    "contradiction_always_material": true,
    "clock_passage_alone_is_material": false,
    "identical_fingerprint_replay_is_material": false,
    "stale_observation_requires_revalidation": true
  },
  "context_packet": {
    "schema": "GardenMaterialContextPacket/v1",
    "architecture_context_capsule_policy": "agents/garden-architecture-context-capsule-policy.json",
    "requires_source_bound_whole_garden_orientation": true,
    "requires_target_source": true,
    "requires_applicable_dependency_closure": true,
    "requires_cross_cutting_obligation_dispositions": true,
    "requires_omission_and_uncertainty_ledger": true,
    "requires_context_sufficiency_verdict": true,
    "max_prompt_characters": 12000,
    "compact_default_max_prompt_characters": 12000,
    "openrouter_review_prompt_ceiling_characters": 200000,
    "preserve_source_backpointers": true,
    "preserve_evidence_ancestry": true,
    "preserve_relevant_contradictions": true,
    "record_omissions": true,
    "raw_evidence_retention_owned_elsewhere": true,
    "snapshot_is_not_truth_or_authority": true,
    "smallest_sufficient_context_not_smallest_possible_context": true,
    "adaptive_context_profile_policy": "agents/openrouter-paid-review-policy.json"
  },
  "context_expansion": {
    "levels": ["L0_CAPSULE", "L1_DEPENDENCY_EXPANDED", "L2_CROSS_LAYER_EXPANDED", "L3_AFFECTED_DOCUMENTS_FULL", "L4_FULL_GARDEN"],
    "reviewer_may_request_expansion": true,
    "material_expansion_request_must_not_be_overruled_by_cost_saving": true,
    "if_initial_five_review_round_needs_material_expansion": "STOP_EXPAND_AND_RESTART_ALL_FIVE_ON_BIT_IDENTICAL_EXPANDED_PACKET",
    "do_not_give_only_one_initial_reviewer_extra_context": true
  },
  "quality_review": {
    "enabled": true,
    "policy": "agents/event-driven-model-quality-policy.json",
    "non_material_default": "NO_MODEL_CALL",
    "material_event_default": "MATERIAL_STRONG_BOARD",
    "cheap_triage_only_for_unresolved_deterministic_classification": true,
    "budget_or_provider_failure_cannot_downgrade_required_assurance": true,
    "review_output_is_proposal_evidence_only": true
  },
  "frontier_handoff": {
    "enabled": true,
    "purpose": "MATERIAL_CHANGE_SYNTHESIS_ONLY",
    "lane": "EXTERNAL_CHATGPT_FRONTIER_REVIEW",
    "provider_boundary": "NOT_OPENROUTER",
    "model_identity": "USER_SELECTED_CHATGPT_MODEL_NOT_HARDCODED_BY_REPOSITORY",
    "request_schema": "GardenFrontierReviewRequest/v1",
    "response_schema": "GardenFrontierReviewResponse/v1",
    "max_handoffs_per_material_event": 1,
    "max_request_characters": 16000,
    "requires_materiality_receipt": true,
    "contains_provider_credentials": false,
    "contains_openrouter_model_route": false,
    "cannot_replace_independent_family_quorum": true,
    "cannot_admit_semantic_delta": true,
    "cannot_grant_authority": true,
    "public_only": true
  },
  "full_context_fallback": {
    "required_when": [
      "dependency closure is unknown or incomplete",
      "reviewer returns FULL_CONTEXT_REQUIRED with a material reason",
      "DesignEpoch or canonical source root changed",
      "HIGH or CRITICAL semantic change crosses multiple owners or files",
      "authority HSA rights consent privacy constitutional or Human-Effect Closure semantics change",
      "compact context cannot establish affected contracts or invariants",
      "whole-source Compare Proof Evidence Challenger or Tier-A closure is required",
      "assurance or audit obligation explicitly requires full revalidation",
      "contradiction or contamination cannot be resolved from the compact packet"
    ],
    "fail_closed_status": "PACKET_INCOMPLETE_OR_CONTEXT_EXPANSION_REQUIRED"
  },
  "measurement": {
    "record_raw_observation_count": true,
    "record_deduplicated_observation_count": true,
    "record_stale_observation_count": true,
    "record_context_characters": true,
    "record_context_capsule_sha256": true,
    "record_context_expansion_level": true,
    "record_context_expansion_requests": true,
    "record_frontier_handoff_avoided": true,
    "record_frontier_handoff_created": true,
    "record_full_context_fallback": true,
    "record_openrouter_provider_cost_separately": true,
    "quality_regression_review_required": true
  },
  "boundary": "This policy routes public proposal evidence only. Context compression, materiality, model review, OpenRouter review or external ChatGPT frontier output creates no truth, Proof, authority, canonical status or merge permission. Bounded context is valid only when the source-bound whole-Garden orientation, target, applicable dependency closure, cross-cutting obligations and omission ledger are sufficient for the review question; otherwise context must expand or fail closed. Request efficiency minimizes redundant remote work but cannot weaken correctness or assurance."
}
