{
  "schema": "GardenEventDrivenContextPolicy/v1",
  "design_epoch": "v15.5",
  "candidate_design_ref": "ankitdcx/garden-main:design_deltas/v15.7/EVENT-DRIVEN-CONTEXT-ROUTING-CANDIDATE.md",
  "status": "PUBLIC_ADAPTER_CANDIDATE_NO_CANONICAL_EFFECT",
  "public_only": true,
  "normalization": {
    "preferred_cost_class": "FREE_OR_LOW_COST",
    "required_observation_schema": "GardenNormalizedContextObservation/v1",
    "required_fields": [
      "observation_id",
      "observed_at_unix",
      "subject",
      "event_kind",
      "fingerprint",
      "changed_fields",
      "risk",
      "uncertainty",
      "source_refs",
      "evidence_refs",
      "summary",
      "public_only"
    ],
    "deduplicate_by": [
      "subject",
      "fingerprint"
    ],
    "risk_is_routing_hint_not_truth": true
  },
  "materiality": {
    "risk_at_or_above": "HIGH",
    "risk_order": [
      "LOW",
      "MEDIUM",
      "HIGH",
      "CRITICAL"
    ],
    "trigger_event_kinds": [
      "SEMANTIC_DELTA",
      "AUTHORITY_CHANGE",
      "RIGHTS_CHANGE",
      "SECURITY_FINDING",
      "PRIVACY_FINDING",
      "TEST_FAILURE",
      "INVARIANT_FAILURE",
      "PROOF_OBLIGATION_CHANGE",
      "DEPENDENCY_INVALIDATION",
      "NEW_OVERTURNING_EVIDENCE"
    ],
    "trigger_uncertainty": [
      "HIGH",
      "UNKNOWN",
      "INCONCLUSIVE"
    ],
    "contradiction_always_material": true,
    "clock_passage_alone_is_material": false,
    "identical_fingerprint_replay_is_material": false,
    "stale_observation_requires_revalidation": true
  },
  "context_packet": {
    "schema": "GardenMaterialContextPacket/v1",
    "max_prompt_characters": 12000,
    "preserve_source_backpointers": true,
    "preserve_evidence_ancestry": true,
    "preserve_relevant_contradictions": true,
    "record_omissions": true,
    "raw_evidence_retention_owned_elsewhere": true,
    "snapshot_is_not_truth_or_authority": true
  },
  "frontier_council": {
    "enabled": true,
    "purpose": "MATERIAL_CHANGE_SYNTHESIS_ONLY",
    "primary_model": "openai/gpt-6-astra",
    "batch_candidate_model": "openai/gpt-6-astra:batch",
    "batch_status": "NOT_WIRED_PENDING_DURABLE_ASYNC_ADAPTER_AND_RETENTION_REVIEW",
    "max_calls_per_material_event": 1,
    "max_prompt_characters": 16000,
    "max_output_tokens": 600,
    "max_call_cost_usd": 0.2,
    "provider_policy": {
      "sort": "price",
      "allow_fallbacks": true,
      "data_collection": "deny",
      "max_price_usd_per_million_tokens": {
        "prompt": 10.0,
        "completion": 50.0
      }
    },
    "requires_materiality_receipt": true,
    "cannot_replace_independent_family_quorum": true,
    "cannot_admit_semantic_delta": true,
    "cannot_grant_authority": true,
    "public_only": true
  },
  "measurement": {
    "record_raw_observation_count": true,
    "record_deduplicated_observation_count": true,
    "record_stale_observation_count": true,
    "record_context_characters": true,
    "record_frontier_call_avoided": true,
    "record_provider_cost": true,
    "quality_regression_review_required": true
  },
  "boundary": "This policy routes public proposal evidence only. Context compression, materiality, model output or cost optimization creates no truth, Proof, authority, canonical status or merge permission."
}
