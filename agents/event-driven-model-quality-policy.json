{
  "schema": "GardenEventDrivenModelQualityPolicy/v1",
  "status": "ACTIVE_NONCANONICAL_OPERATIONAL_POLICY",
  "effective_date": "2026-09-19",
  "design_epoch": "v15.10-working-candidate-process",
  "public_only": true,
  "provider_exclusion_policy": "agents/provider-exclusion-policy.json",
  "event_context_policy": "agents/event-driven-context-policy.json",
  "independent_branch_convergence_policy": "agents/independent-branch-convergence-policy.json",
  "purpose": "USE_THE_CHEAPEST_OBSERVED_USEFUL_DIVERSE_REVIEWERS; ESCALATE_ONLY_BY_EXPLICIT_HUMAN_DECISION",
  "activation": {
    "clock_passage_never_authorizes_model_spend": true,
    "identical_fingerprint_replay_never_authorizes_model_spend": true,
    "no_change_default": "NO_MODEL_CALL",
    "deterministic_gate_before_model": true,
    "private_chatgpt_baseline_commitment_required_before_openrouter_inference": true,
    "provider_failure_does_not_authorize_weaker_assurance": true,
    "moving_latest_aliases_are_not_used_for_evidence_lineage": true,
    "model_ids_are_pinned_until_a_new_catalog_review_event": true
  },
  "budget": {
    "daily_openrouter_cost_ceiling_usd": 1,
    "routine_material_event_reserved_ceiling_usd": 0.25,
    "routine_model_call_reserved_ceiling_usd": 0.05,
    "absolute_openrouter_inference_calls_per_convergence_task": 15,
    "automatic_expensive_escalation_daily_ceiling_usd": 0,
    "audit_daily_openrouter_cost_ceiling_usd": 2,
    "review_profiles_source": "agents/openrouter-paid-review-policy.json:review_profiles"
  },
  "tiers": {
    "DETERMINISTIC_NO_MODEL": {
      "default": true,
      "use_when": "dedupe, schema, hash, dependency, known-rule, regression and materiality checks can resolve the event without a model"
    },
    "MATERIAL_VALUE_BOARD": {
      "execution_status": "ACTIVE_ONLY_INSIDE_INDEPENDENT_BRANCH_CONVERGENCE_PROTOCOL",
      "use_when": "bounded public material event requires independent model review",
      "blind_round_required": true,
      "same_neutral_query_for_all_five_initial_reviewers": true,
      "peer_answer_sharing": "FORBIDDEN",
      "openrouter_models": [
        {
          "family": "deepseek",
          "model": "deepseek/deepseek-v4-pro-0813",
          "role": "determinism_hidden_inputs_and_derivation"
        },
        {
          "family": "xiaomi",
          "model": "xiaomi/mimo-v2.5-pro",
          "role": "implementation_interactions_and_failure_cases"
        },
        {
          "family": "nvidia",
          "model": "nvidia/nemotron-3-ultra-550b-a55b",
          "role": "architecture_boundaries_ownership_and_scalability"
        },
        {
          "family": "pareto",
          "model": "unbiased/pareto",
          "role": "claims_equivalence_proof_and_assurance_discipline"
        },
        {
          "family": "mistral",
          "model": "mistralai/mistral-medium-3-5",
          "role": "serialization_state_ordering_timing_and_edge_cases"
        }
      ],
      "chatgpt_reconciliation": "VERIFY_EACH_FINDING_AND_SYNTHESIZE_WITHOUT_MODEL_VOTING",
      "model_followups_per_branch": 0,
      "final_review": "BIT_IDENTICAL_REPAIRED_CANDIDATE_TO_ALL_FIVE_WHEN_CANDIDATE_CHANGED",
      "maximum_confirmation_rounds": 1,
      "model_agreement_is_not_proof": true
    },
    "SHADOW_CANDIDATE": {
      "automatic_dispatch": false,
      "models": [
        {
          "family": "glm",
          "model": "z-ai/glm-5.3",
          "reason": "One strong answer in five campaign calls; useful but insufficient output reliability for routine quorum."
        }
      ]
    },
    "EXPENSIVE_ESCALATION": {
      "automatic_dispatch": false,
      "requires_explicit_human_opt_in": true,
      "default_models": [],
      "note": "A future human may explicitly select an expensive challenger for a specific unresolved question; this policy never does so automatically."
    }
  },
  "campaign_observations": {
    "source": "docs/OPENROUTER_MODEL_VALUE_REVIEW_2026-09-19.md",
    "observation_is_not_general_model_quality_proof": true
  },
  "excluded_families_must_never_be_used_even_if_cheaper_or_higher_scoring": true,
  "boundary": "This policy selects review quality/cost posture only. Model output remains proposal evidence and cannot create truth, Proof, authority, merge permission, canonical status, or human admission."
}
