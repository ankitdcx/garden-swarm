{
  "schema": "GardenOpenRouterPaidReviewPolicy/v1",
  "revision": 4,
  "purpose": "EVENT_DRIVEN_LOW_COST_SPECIALIST_REVIEW",
  "design_epoch": "v15.10-working-candidate-process",
  "catalog_reference_date": "2026-09-19",
  "public_only": true,
  "semantic_delta_admitted": false,
  "provider_exclusion_policy": "agents/provider-exclusion-policy.json",
  "reviewer_quality_policy": "agents/reviewer-quality-policy.json",
  "reviewer_slot_registry": "agents/reviewer-slot-registry.json",
  "event_driven_model_quality_policy": "agents/event-driven-model-quality-policy.json",
  "independent_branch_convergence_policy": "agents/independent-branch-convergence-policy.json",
  "daily_openrouter_cost_ceiling_usd": 2,
  "routine_task_cost_ceiling_usd": 2,
  "routine_hourly_cost_ceiling_usd": 2,
  "routine_model_call_cost_ceiling_usd": 0.01,
  "automatic_expensive_escalation_daily_ceiling_usd": 0,
  "max_prompt_characters": 200000,
  "max_output_tokens": 32000,
  "provider_policy": {
    "sort": "price",
    "allow_fallbacks": true,
    "data_collection": "deny",
    "ignore": [],
    "max_price_usd_per_million_tokens": {
      "prompt": 1,
      "completion": 3
    }
  },
  "routine_reviewers": [
    {
      "family": "deepseek",
      "role": "determinism_hidden_inputs_and_derivation",
      "model": "deepseek/deepseek-v4-pro-0813"
    },
    {
      "family": "xiaomi",
      "role": "implementation_interactions_and_failure_cases",
      "model": "xiaomi/mimo-v2.5-pro"
    },
    {
      "family": "nvidia",
      "role": "architecture_boundaries_ownership_and_scalability",
      "model": "nvidia/nemotron-3-ultra-550b-a55b"
    },
    {
      "family": "pareto",
      "role": "claims_equivalence_proof_and_assurance_discipline",
      "model": "unbiased/pareto"
    },
    {
      "family": "mistral",
      "role": "serialization_state_ordering_timing_and_edge_cases",
      "model": "mistralai/mistral-medium-3-5"
    }
  ],
  "event_driven_activation": {
    "paid_review_requires_material_event_or_explicit_high_risk_obligation": true,
    "deterministic_gate_before_model": true,
    "clock_passage_alone_never_authorizes_spend": true,
    "identical_state_replay_never_authorizes_spend": true,
    "no_change_default": "NO_PAID_CALL",
    "private_chatgpt_baseline_commitment_required_before_first_openrouter_inference": true
  },
  "review_process": {
    "normal_initial_round": "FIVE_BLIND_SPECIALISTS_SAME_PACKET",
    "chatgpt_reconciliation": "VERIFY_EACH_FINDING_AND_MAINTAIN_STRUCTURED_FINDING_LEDGER",
    "easy_close": "IF_ALL_FIVE_RETURN_NO_CHANGE_AND_CHATGPT_LOCAL_GATES_FIND_NO_MATERIAL_ISSUE_CLOSE_AFTER_INITIAL_ROUND",
    "repair": "INTEGRATE_ONLY_REPRODUCED_OR_EVIDENCE_SUPPORTED_FINDINGS_THEN_RERUN_DETERMINISTIC_TESTS",
    "final_round": "IF_CANDIDATE_CHANGED_SEND_BIT_IDENTICAL_REVISED_CANDIDATE_TO_ALL_FIVE",
    "confirmation": "AT_MOST_ONE_ADDITIONAL_FIVE_MODEL_ROUND_AFTER_A_VALID_FINAL_PATCH",
    "unresolved": "STOP_WITH_EXPLICIT_DISAGREEMENT_OR_EVIDENCE_GAP_RECEIPT",
    "peer_answer_sharing": "FORBIDDEN_DURING_INDEPENDENT_MODEL_ROUNDS",
    "majority_vote": "FORBIDDEN_AS_ADMISSION_RULE"
  },
  "structured_finding_required_fields": [
    "finding_id",
    "reviewer_family",
    "candidate_sha256",
    "affected_owner_or_location",
    "claim_challenged",
    "concrete_counterexample_or_gap",
    "severity",
    "proposed_patch",
    "chatgpt_reproduction_status",
    "disposition",
    "patch_ref",
    "regression_test",
    "closed_by_candidate_sha256"
  ],
  "shadow_candidates": [
    {
      "family": "glm",
      "model": "z-ai/glm-5.3",
      "status": "SHADOW_ONLY_OUTPUT_RELIABILITY_INSUFFICIENT",
      "campaign_visible_answers": 1,
      "campaign_calls": 5
    }
  ],
  "expensive_escalation": {
    "automatic_dispatch": false,
    "requires_explicit_human_opt_in": true,
    "models_not_routinely_used": [
      "openai/gpt-6-astra",
      "anthropic/claude-opus-5",
      "google/gemini-3.1-pro-preview",
      "x-ai/grok-4.6",
      "qwen/qwen3.8-2.4t-a95b",
      "moonshotai/kimi-k3",
      "sakana/fugu-ultra-v2"
    ]
  },
  "campaign_value_evidence": {
    "source": "docs/OPENROUTER_MODEL_VALUE_REVIEW_2026-09-19.md",
    "boundary": "Observed usefulness/cost from one Garden v15.10 campaign; not general model-quality proof."
  },
  "execution_limits": {
    "max_concurrent_model_calls": 1,
    "max_model_calls_per_dispatch": 1,
    "absolute_inference_calls_per_task": 15,
    "normal_expected_calls_if_candidate_changes": 10,
    "easy_case_calls": 5,
    "maximum_confirmation_rounds": 1,
    "scope": "SHARED_ACROSS_ALL_LANES",
    "daily_free_call_cap": 48,
    "hourly_free_call_cap": 2,
    "enforcement_status": "ACTIVE_SINGLE_CALL_INDEPENDENT_REVIEW_LEDGER; LEGACY_BATCH_PATHS_NOT_ADMITTED",
    "family_counts": "Five paid reviewer families are accumulated sequentially across isolated dispatches; counts are review-cycle diversity targets, never concurrency grants."
  },
  "review_profiles": {
    "ROUTINE": {
      "max_output_tokens": 8000,
      "context_characters": 32000,
      "max_support_passages": 8,
      "reasoning_effort": "medium",
      "request_timeout_seconds": 180
    },
    "COMPLEX": {
      "max_output_tokens": 16000,
      "context_characters": 64000,
      "max_support_passages": 16,
      "reasoning_effort": "high",
      "request_timeout_seconds": 240
    },
    "DEEP": {
      "max_output_tokens": 32000,
      "context_characters": 100000,
      "max_support_passages": 24,
      "reasoning_effort": "high",
      "request_timeout_seconds": 300
    }
  },
  "spending_modes": {
    "DEFAULT": {
      "daily_ceiling_usd": 2,
      "per_call_ceiling_usd": 0.01
    }
  },
  "notes": [
    "The five routine reviewers are assigned different failure-search roles; diversity comes from role specialization as well as model family.",
    "No model sees another model's answer during blind/final/confirmation rounds.",
    "ChatGPT verifies and dispositions findings; model agreement is evidence, never Proof or authority.",
    "A single correct material counterexample defeats any number of approvals.",
    "NO_SUBSTANTIVE_OUTPUT is recorded and not automatically retried against an unchanged packet.",
    "Expensive frontier models require an explicit future human opt-in and are never automatic.",
    "This policy is operational only and creates no Garden semantic authority.",
    "Anthropic/Claude, NVIDIA/Nemotron and Mistral are currently re-authorized for Garden review by explicit human directives; eligibility does not imply automatic selection, authority, safety certification or paid-budget permission.",
    "Controlling paid OpenRouter budget rule from the explicit 2026-09-20 human directive: maximum USD 2 total spend per UTC day and maximum USD 0.01 per paid call.",
    "Legacy budget pool/task/hour fields remain only for compatibility with disabled historical tooling and are non-controlling for the active GROUP_REVIEW paid lane."
  ],
  "budget_pools_usd": {
