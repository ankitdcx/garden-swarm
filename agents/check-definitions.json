        "invalid cost",
        "automatic semantic admission",
        "duplicate reviewer family"
      ],
      "pass_boundary": "Input boundary conformance only; does not establish quorum, independent approval or canonical admission.",
      "tests": "tests/test_review_boundaries.py"
