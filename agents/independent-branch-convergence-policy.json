{
  "schema": "GardenIndependentBranchConvergencePolicy/v1",
  "status": "ACTIVE_NONCANONICAL_OPENROUTER_WORK_PROTOCOL",
  "effective_date": "2026-09-19",
  "revision": 3,
  "scope": "ALL_GARDEN_OPENROUTER_MODEL_INFERENCE_WORK",
  "public_only": true,
  "purpose": "LOW_COST_FIVE_SPECIALIST_INDEPENDENT_REVIEW_WITH_CHATGPT_RECONCILIATION",
  "boundaries": {
    "openrouter_metadata_catalog_and_billing_queries_are_not_model_inference": true,
    "model_output_is_proposal_evidence_only": true,
    "agreement_is_not_proof": true,
    "no_model_may_grant_authority_or_promote_canon": true,
    "excluded_provider_policy": "agents/provider-exclusion-policy.json",
    "event_quality_policy": "agents/event-driven-model-quality-policy.json",
    "architecture_context_capsule_policy": "agents/garden-architecture-context-capsule-policy.json"
  },
  "private_baseline": {
    "owner": "EXTERNAL_CHATGPT_FRONTIER",
    "must_exist_before_first_openrouter_inference": true,
    "content_must_not_be_sent_in_initial_blind_round": true,
    "repository_receives_commitment_only": true,
    "commitment_schema": "GardenPrivateBaselineCommitment/v1",
    "required_fields": [
      "baseline_sha256",
      "neutral_query_sha256",
      "source_packet_sha256",
      "created_before_openrouter_calls"
    ],
    "disclosure_after_blind": "FINAL_AND_CONFIRM_REQUIRE_EXACT_COMMITTED_PUBLIC_BASELINE; PRIVATE_CONTENT_MUST_NOT_BE_DISCLOSED"
  },
  "source_packet": {
    "must_follow": "GardenArchitectureContextCapsulePolicy/v1",
    "must_include_source_bound_whole_garden_orientation": true,
    "must_include_exact_target_source": true,
    "must_include_applicable_dependency_closure": true,
    "must_include_cross_cutting_obligation_dispositions": true,
    "must_include_omission_and_uncertainty_ledger": true,
    "context_capsule_sha256_required": true,
    "reviewer_context_verdict": [
      "SUFFICIENT",
      "EXPAND_REQUIRED",
      "FULL_CONTEXT_REQUIRED"
    ],
    "missing_context_must_not_be_guessed": true
  },
  "reviewer_board": {
    "source": "agents/openrouter-paid-review-policy.json:routine_reviewers",
    "required_distinct_families": 5,
    "sequential_only": true,
    "same_neutral_query_and_source_packet_for_all_initial_reviews": true,
    "same_context_capsule_sha256_for_all_initial_reviews": true,
    "role_specialization_required": true,
    "initial_reviewers_must_not_receive": [
      "ChatGPT baseline content",
      "another reviewer's answer",
      "a summary derived from another reviewer's answer"
    ]
  },
  "context_expansion_rule": {
    "if_any_initial_branch_identifies_material_missing_context": "STOP_CURRENT_BLIND_ROUND_EXPAND_PACKET_AND_RESTART_ALL_FIVE_INITIAL_REVIEWS",
    "expanded_initial_packet_must_again_be_bit_identical_across_five_reviewers": true,
    "cost_or_call_savings_cannot_override_required_context_expansion": true,
    "full_context_fallback_when_capsule_cannot_establish_dependency_or_cross_cutting_semantics": true
  },
  "branch_protocol": {
    "initial_calls": 5,
    "branches": "ONE_PER_REVIEWER_FAMILY",
    "model_followups_per_branch": 0,
    "chatgpt_reconciliation_only": true,
    "structured_finding_ledger_required": true,
    "closure_outcomes": [
      "NO_FOLLOWUP_NEEDED",
      "INTEGRATED_FOR_FINAL_AUDIT",
      "REJECTED_WITH_EVIDENCE",
      "UNRESOLVED_BLOCK"
    ],
    "normal_path": "FIVE_BLIND -> CHATGPT_VERIFY_AND_INTEGRATE -> DETERMINISTIC_TESTS -> FIVE_FINAL_IF_CHANGED",
    "easy_path": "FIVE_BLIND_NO_CHANGE_PLUS_CLEAN_LOCAL_GATES -> CLOSE",
    "do_not_force_consensus": true
  },
  "synthesis": {
    "owner": "EXTERNAL_CHATGPT_FRONTIER",
    "input": "FIVE_LOCKED_BLIND_RESULTS_PLUS_LOCAL_EVIDENCE",
    "must_record": [
      "every original finding",
      "common conclusions",
      "material disagreements",
      "evidence differences",
      "surviving counterexamples",
      "discarded alternatives with reason",
      "DO_NOTHING alternative",
      "uncertainty",
      "context sufficiency and expansion history"
    ],
    "model_outputs_cannot_self_synthesize_across_branches": true,
    "structured_finding_ledger_schema": "GardenOpenRouterFindingLedger/v2"
  },
  "final_review": {
    "reviewers": 5,
    "sequential_only": true,
    "required_only_if_candidate_changed_or_material_issue_integrated": true,
    "all_reviewers_receive_bit_identical_merged_candidate": true,
    "all_reviewers_receive_same_final_context_capsule": true,
    "reviewers_do_not_receive_other_final_reviews": true,
    "allowed_verdicts": [
      "APPROVE",
      "BLOCK",
      "APPROVE_WITH_PATCH"
    ],
    "material_block_or_patch_requires_chatgpt_reintegration": true,
    "maximum_confirmation_rounds": 1,
    "confirmation_uses_bit_identical_revised_candidate_for_all_reviewers": true,
    "synthesis_audit_required": true,
    "synthesis_audit_schema": "GardenSynthesisAuditPacket/v1"
  },
  "stop_rule": {
    "success_condition": "NO_UNRESOLVED_MATERIAL_CONTRADICTION_COUNTEREXAMPLE_EVIDENCE_GAP_VIOLATED_INVARIANT_CONTEXT_GAP_OR_STRONGER_KNOWN_ALTERNATIVE_REMAINS_AT_REQUIRED_ASSURANCE_LEVEL",
    "five_of_five_agreement_is_insufficient_by_itself": true,
    "one_valid_material_counterexample_overrides_any_number_of_approvals": true,
    "unresolved_after_confirmation": "STOP_WITH_EXPLICIT_DISAGREEMENT_RECEIPT; NO_AUTOMATIC_EXPENSIVE_ESCALATION",
    "after_all_approvals": "AWAITING_CHATGPT_FINAL_DECISION; approvals never automatically admit a semantic delta."
  },
  "call_budget": {
    "easy_case_minimum_calls": 5,
    "normal_expected_calls": 10,
    "absolute_maximum_openrouter_inference_calls_per_task": 15,
    "derivation": "5 initial + 5 final if changed + up to 5 one-time confirmation",
    "daily_openrouter_cost_ceiling_usd": 1,
    "task_cost_ceiling_usd": 0.25,
    "call_reservation_ceiling_usd": 0.05,
    "audit_daily_openrouter_cost_ceiling_usd": 2,
    "audit_task_cost_ceiling_usd": 0.5,
    "budget_exhaustion": "STOP_OR_DEFER; NEVER_DROP_REQUIRED_CONTEXT_OR WEAKEN ASSURANCE TO SAVE COST"
  },
  "transport": {
    "one_inference_call_per_dispatch": true,
    "max_concurrent_model_calls": 1,
    "durable_state_required_before_call": true,
    "unknown_call_or_unknown_billing_blocks_further_inference": true,
    "external_chatgpt_directive_required_between_protocol_phases": true,
    "directive_schema": "GardenIndependentBranchDirective/v1",
    "maximum_attempts_per_slot": 2,
    "no_substantive_output": "RECORD_NO_SUBSTANTIVE_OUTPUT_AND_DO_NOT_AUTOMATICALLY_RETRY_UNCHANGED_PACKET"
  },
  "expensive_escalation": {
    "automatic": false,
    "requires_explicit_human_opt_in": true,
    "unresolved_material_issue_does_not_authorize_expensive_model_spend": true
  },
  "legacy_disposition": {
    "peer_cross_examination": "SUPERSEDED_FOR_ROUTINE_OPENROUTER_REVIEW",
    "per_branch_model_followups": "SUPERSEDED_FOR_ROUTINE_OPENROUTER_REVIEW",
    "four_reviewer_board": "SUPERSEDED_BY_FIVE_SPECIALIST_BOARD_2026-09-19",
    "legacy_outputs_without_current_protocol_receipt": "NON_ADMISSIBLE_AS_CURRENT_GARDEN_MULTI_MODEL_CONVERGENCE_EVIDENCE"
  }
}
